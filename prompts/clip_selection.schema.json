{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitechx.local/schemas/clip-selection-1.0.json",
  "title": "CorteX Clip Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_notes", "clips"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "selection_notes": { "type": "string", "maxLength": 1000 },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/clip" }
    }
  },
  "$defs": {
    "narrativeBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_second", "end_second", "summary", "evidence"],
      "properties": {
        "start_second": { "type": "number", "minimum": 0 },
        "end_second": { "type": "number", "exclusiveMinimum": 0 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spoken_hook", "standalone_clarity", "emotion", "quotability",
        "payoff", "compression_safety", "audience_relevance", "total"
      ],
      "properties": {
        "spoken_hook": { "type": "integer", "minimum": 1, "maximum": 5 },
        "standalone_clarity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "emotion": { "type": "integer", "minimum": 1, "maximum": 5 },
        "quotability": { "type": "integer", "minimum": 1, "maximum": 5 },
        "payoff": { "type": "integer", "minimum": 1, "maximum": 5 },
        "compression_safety": { "type": "integer", "minimum": 1, "maximum": 5 },
        "audience_relevance": { "type": "integer", "minimum": 1, "maximum": 5 },
        "total": { "type": "integer", "minimum": 7, "maximum": 35 }
      }
    },
    "edlItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order", "source_start", "source_end", "purpose", "preferred_visual",
        "audio_mode", "transition_in", "mask_jump_with", "confidence", "notes"
      ],
      "properties": {
        "order": { "type": "integer", "minimum": 0 },
        "source_start": { "type": "number", "minimum": 0 },
        "source_end": { "type": "number", "exclusiveMinimum": 0 },
        "purpose": {
          "type": "string",
          "enum": ["hook", "context", "development", "reaction", "payoff"]
        },
        "preferred_visual": {
          "type": "string",
          "enum": ["primary_speaker", "interviewer_reaction", "wide", "auto"]
        },
        "audio_mode": {
          "type": "string",
          "enum": ["source", "primary_continuity", "room_tone"]
        },
        "transition_in": {
          "type": "string",
          "enum": ["none", "hard_cut", "jump_cut", "j_cut", "l_cut"]
        },
        "mask_jump_with": {
          "type": "string",
          "enum": ["none", "punch_in", "reaction", "wide"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string", "maxLength": 300 }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank", "title", "headline", "start_second", "end_second",
        "estimated_duration", "primary_speaker", "topic", "pacing", "hook", "context",
        "payoff", "approximate_edl", "scores", "reasoning", "warnings"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 25 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "headline": { "type": "string", "minLength": 4, "maxLength": 100 },
        "start_second": { "type": "number", "minimum": 0 },
        "end_second": { "type": "number", "exclusiveMinimum": 0 },
        "estimated_duration": { "type": "number", "minimum": 15, "maximum": 180 },
        "primary_speaker": { "type": "string", "minLength": 1, "maxLength": 100 },
        "topic": { "type": "string", "maxLength": 160 },
        "pacing": {
          "type": "string",
          "enum": ["dynamic", "balanced", "contemplative"]
        },
        "hook": { "$ref": "#/$defs/narrativeBeat" },
        "context": { "$ref": "#/$defs/narrativeBeat" },
        "payoff": { "$ref": "#/$defs/narrativeBeat" },
        "approximate_edl": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/edlItem" }
        },
        "scores": { "$ref": "#/$defs/score" },
        "reasoning": { "type": "string", "minLength": 1, "maxLength": 800 },
        "warnings": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "maxLength": 240 }
        }
      }
    }
  }
}
