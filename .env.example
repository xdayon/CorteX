# Copie para ~/.local/share/podcli/.env e preencha. NÃO comitar o .env real.

# Token do Hugging Face (usado pela diarização/modelos gated). Pegue o seu.
HF_TOKEN=coloque_seu_token_aqui

# --- Engine de transcrição ---
# fasterwhisper = GPU (CTranslate2/CUDA int8) na GTX 1060, via venv separado.
# Se o venv/worker sumir, cai automaticamente pro whisper.cpp (CPU).
PODCLI_ENGINE=fasterwhisper

# --- faster-whisper (GPU) ---
# Python do venv que tem faster_whisper + libs CUDA (pacotes nvidia-*).
PODCLI_FASTERWHISPER_PYTHON=/var/home/dx/Projects/transcription/venv/bin/python
# large-v3-turbo = melhor velocidade (2-3x mais rápido) + boa qualidade na 1060 (int8).
PODCLI_FASTERWHISPER_MODEL=large-v3-turbo
PODCLI_FASTERWHISPER_DEVICE=cuda
PODCLI_FASTERWHISPER_COMPUTE=int8
PODCLI_FASTERWHISPER_VAD=1
# Batched decode (~3-4x): trechos de fala decodificados em paralelo na GPU.
# 8 cabe nos 6GB da 1060 com large-v3-turbo int8; 0 desliga (sequencial).
PODCLI_FASTERWHISPER_BATCH=8
PODCLI_FASTERWHISPER_PROMPT=Transcrição em português do Brasil, com pontuação e acentuação corretas.

# --- Render na GPU (NVENC) ---
# ffmpeg do sistema tem h264_nvenc; o embutido é CPU-only.
PODCLI_FFMPEG=/usr/bin/ffmpeg
PODCLI_FFPROBE=/usr/bin/ffprobe

# Pasta raiz onde os clipes finais sao salvos.
PODCLI_OUTPUT=/var/home/dx/Videos/podcli-clips

# --- Remotion (render de legendas) ---
# Concorrencia de workers do Remotion (default: min(cpus, 12)).
# PODCLI_REMOTION_CONCURRENCY=12
# PODCLI_REMOTION_GL=angle-egl  # experimental: raster do Chromium na GPU
