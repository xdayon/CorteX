# CorteX reads its YAML from CORTEX_CONFIG (default config/cortex.yaml) and lets
# CORTEX__SECTION__KEY variables in the process environment override single keys
# (for example CORTEX__AI__CLAUDE_EFFORT=high sets ai.claude_effort). It does not
# load .env files itself: source this file or set the same variables in the
# service manager. Unknown keys are rejected when the config loads.

CORTEX_CONFIG=config/cortex.yaml

# Runtime paths (relative paths are resolved from the working directory).
# CORTEX__PATHS__DATA_DIR=data
# CORTEX__PATHS__PROJECTS_DIR=data/projects
# CORTEX__PATHS__CACHE_DIR=data/cache
# CORTEX__PATHS__OUTPUT_DIR=data/output
# CORTEX__PATHS__DATABASE=data/cortex.sqlite3

# Local transcription. Requested and effective engines are persisted; CPU
# fallback is opt-in and never silent.
# CORTEX__TRANSCRIPTION__MODEL=large-v3-turbo
# CORTEX__TRANSCRIPTION__LANGUAGE=pt
# CORTEX__TRANSCRIPTION__DEVICE=cuda
# CORTEX__TRANSCRIPTION__COMPUTE_TYPE=int8
# CORTEX__TRANSCRIPTION__BATCH_SIZE=8
# CORTEX__TRANSCRIPTION__VAD=true
# CORTEX__TRANSCRIPTION__ALLOW_CPU_FALLBACK=false

# Render engine. Use libx264 explicitly for the CPU path.
# CORTEX__RENDER__FFMPEG=/usr/bin/ffmpeg
# CORTEX__RENDER__FFPROBE=/usr/bin/ffprobe
# CORTEX__RENDER__ENCODER=h264_nvenc

# Editorial AI provider: claude_code_cli (Claude subscription, active) or
# codex_cli (explicit alternative). There is no fallback between providers and
# no API billing.
# CORTEX__AI__PROVIDER=claude_code_cli
# CORTEX__AI__CLAUDE_MODEL=claude-sonnet-5-5
# CORTEX__AI__CLAUDE_EFFORT=medium
# CORTEX__AI__TIMEOUT_SECONDS=900

# Secrets read from the environment (set the values in the untracked .env, never
# here): HF_TOKEN (speaker diarization models), SOUNDZA_API_KEY (sound library).
