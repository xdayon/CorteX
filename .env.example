# CorteX reads YAML from CORTEX_CONFIG and optional CORTEX__SECTION__KEY
# overrides from the process environment. It does not load .env files itself;
# source this file or configure the same variables in the service manager.

CORTEX_CONFIG=config/cortex.yaml

# Runtime paths (relative paths are resolved from the working directory).
# CORTEX__PATHS__DATA_DIR=data
# CORTEX__PATHS__PROJECTS_DIR=data/projects
# CORTEX__PATHS__CACHE_DIR=data/cache
# CORTEX__PATHS__OUTPUT_DIR=data/output
# CORTEX__PATHS__DATABASE=data/cortex.sqlite3

# Local-first transcription. Requested and effective engines are persisted;
# CPU fallback is opt-in and is never silent.
# CORTEX__TRANSCRIPTION__MODEL=large-v3-turbo
# CORTEX__TRANSCRIPTION__LANGUAGE=pt
# CORTEX__TRANSCRIPTION__DEVICE=cuda
# CORTEX__TRANSCRIPTION__COMPUTE_TYPE=int8
# CORTEX__TRANSCRIPTION__BATCH_SIZE=8
# CORTEX__TRANSCRIPTION__VAD=true
# CORTEX__TRANSCRIPTION__ALLOW_CPU_FALLBACK=false

# Render engine. Use libx264 explicitly for the CPU path. Do not enable
# fallback when benchmark or release evidence must prove NVENC was effective.
# CORTEX__RENDER__FFMPEG=/usr/bin/ffmpeg
# CORTEX__RENDER__FFPROBE=/usr/bin/ffprobe
# CORTEX__RENDER__REMOTION_NODE=node
# CORTEX__RENDER__REMOTION_BROWSER=/path/to/chrome-headless-shell
# CORTEX__RENDER__ENCODER=h264_nvenc
# CORTEX__RENDER__ALLOW_CPU_FALLBACK=false

# Replaceable CLI LLM adapters. No API token is required for the local-first
# path; fallback provider changes are explicit and recorded in provenance.
# CORTEX__AI__PROVIDER=codex_cli
# CORTEX__AI__FALLBACK_PROVIDER=claude_cli
# CORTEX__AI__CODEX_BINARY=codex
# CORTEX__AI__CODEX_MODEL=gpt-5.5
# CORTEX__AI__CODEX_REASONING_EFFORT=medium
# CORTEX__AI__CLAUDE_BINARY=claude
# CORTEX__AI__CLAUDE_MODEL=fable
# CORTEX__AI__TIMEOUT_SECONDS=300
